# TLS automatico y ruteo, en las lineas que hacen falta y ninguna mas.
#
# Solo dos nombres publicos, y eso es una decision de seguridad y no una omision:
#
#   - La aplicacion (BitFront) es lo que usa una persona. Su proxy de Nitro alcanza a las APIs
#     por la red interna, asi que el navegador nunca les habla.
#   - Platform es publica por un solo motivo: la notificacion de pago es una ruta anonima que
#     tiene que alcanzar el gateway desde afuera.
#
# PIMA y BIT no tienen nombre. A PIMA solo la llaman servicios; lo publico de BIT lo sirve
# BitFront. Ademas de no estar ruteados, no estan en la red `edge` del compose: publicarlos por
# accidente requeriria dos cambios y no uno.

{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy bitfront:3000
}

{$PLATFORM_DOMAIN} {
	encode zstd gzip
	reverse_proxy platform-api:8080
}
