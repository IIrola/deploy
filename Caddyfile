# TLS automatico y ruteo, en las lineas que hacen falta y ninguna mas.
#
# Solo dos nombres publicos, y eso es una decision de seguridad y no una omision:
#
#   - El sitio publico y la consola: las dos aplicaciones que usa una persona. Su proxy de Nitro
#     alcanza a las APIs por la red interna, asi que el navegador nunca les habla.
#   - Platform es publica por un solo motivo: la notificacion de pago es una ruta anonima que
#     tiene que alcanzar el gateway desde afuera.
#
# PIMA y BIT no tienen nombre. A PIMA solo la llaman servicios; lo publico de BIT lo sirve
# el sitio publico. Ademas de no estar ruteados, no estan en la red `edge` del compose: publicarlos por
# accidente requeriria dos cambios y no uno.

{
	email {$ACME_EMAIL}
}

http://{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

# La consola en su propio nombre, y no en una ruta del sitio publico. Separarlas es lo que permite
# restringir esta —por IP, por VPN— sin tocar lo que tiene que ser publico: aca no hay una sola
# pagina anonima.
http://{$CONSOLE_DOMAIN} {
	encode zstd gzip
	reverse_proxy console:3000
}

http://{$PLATFORM_DOMAIN} {
	encode zstd gzip
	reverse_proxy platform-api:8080
}
