# Copiar como .env EN EL VPS, completar, y dejarlo en 0600. Nunca se commitea.
#
#   cp .env.example .env && chmod 600 .env
#
# El pipeline no tiene ninguno de estos valores: el release solo hace `pull` y `up`. Rotar un
# secreto es editar este archivo y volver a levantar — no toca el repositorio ni GitHub.

# --- de donde salen las imagenes -------------------------------------------------------------
GHCR_OWNER=IIrola

# Etiquetas. `latest` es lo normal; para volver atras, poner el SHA del commit que si andaba y
# `docker compose up -d`. Por eso cada imagen se publica tambien con su SHA.
PLATFORM_TAG=latest
PIMA_TAG=latest
TOURISM_TAG=latest
CONSOLE_TAG=latest
WEB_TAG=latest

# --- nombres publicos -------------------------------------------------------------------------
APP_DOMAIN=app.ejemplo.com
CONSOLE_DOMAIN=consola.ejemplo.com
PLATFORM_DOMAIN=api.ejemplo.com
ACME_EMAIL=ops@ejemplo.com

# --- base de datos ----------------------------------------------------------------------------
MARIADB_ROOT_PASSWORD=

PLATFORM_DB_NAME=platform
PLATFORM_DB_USER=platform
PLATFORM_DB_PASSWORD=

PIMA_DB_NAME=pima
PIMA_DB_USER=pima
PIMA_DB_PASSWORD=

TOURISM_DB_NAME=tourism
TOURISM_DB_USER=tourism
TOURISM_DB_PASSWORD=

# --- identidad --------------------------------------------------------------------------------
# La misma clave para los tres: Platform firma y PIMA y BIT validan. Minimo 32 caracteres.
JWT_SIGNING_KEY=
JWT_ISSUER=https://api.ejemplo.com

# Credenciales de servicio, registradas en Platform. Hoy es un paso manual del runbook — ver
# README, "Lo que el pipeline todavia no resuelve".
PIMA_CLIENT_ID=pima-core
PIMA_CLIENT_SECRET=
TOURISM_CLIENT_ID=tourism-core
TOURISM_CLIENT_SECRET=

# --- integraciones ----------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Vacio deja a PIMA sin colectores: evalua con lo que le afirma el llamador y lo dice en su
# cobertura. Arranca y avisa; no falla.
TRUSTFULL_API_KEY=

SMTP_PASSWORD=
SMS_PASSWORD=
