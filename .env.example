# Copiar como .env EN EL VPS, completar, y dejarlo en 0600. Nunca se commitea.
#
#   cp .env.example .env && chmod 600 .env
#
# El pipeline no tiene ninguno de estos valores: el release solo hace `pull` y `up`. Rotar un
# secreto es editar este archivo y volver a levantar — no toca el repositorio ni GitHub.

# --- de donde salen las imagenes -------------------------------------------------------------
GHCR_OWNER=IIrola

# Etiquetas. `latest` es lo normal; para volver atras, poner el SHA del commit que si andaba y
# `docker compose up -d`. Por eso cada imagen se publica tambien con su SHA.
PLATFORM_TAG=latest
PIMA_TAG=latest
# La API de la vertical...
TOURISM_TAG=latest
BIDA_TAG=latest
CONSOLE_TAG=latest
# ...y los dos sitios: el de la plataforma y el de la vertical. Son etiquetas distintas a
# proposito: desplegar la vertical no debe obligar a mover la plataforma.

# --- nombres publicos -------------------------------------------------------------------------
# **Dos, y no cuatro.** Los sitios estaticos salieron de este despliegue: ver PUBLIC_SITE_URL.
#
# La consola, que es la unica aplicacion con sesion. **Ojo con el nombre si venis del despliegue
# anterior**: un host con marca de una vertical sirviendo la consola transversal es la regla que
# este proyecto ya escribio —un nombre que contiene una vertical empieza a mentir el dia que se
# suma la segunda— y la segunda ya existe. Moverlo es editar esto, el DNS y esperar el
# certificado; cierra todas las sesiones abiertas, porque la cookie esta fijada al host.
CONSOLE_DOMAIN=consola.ejemplo.com

# El sitio publico, que NO lo despliega este compose: es estatico, esta hecho en Astro y vive en
# otro repositorio. La consola enlaza hacia el y el enlaza el inicio de sesion y el alta de la
# consola. URL completa, porque puede estar en cualquier host y esquema.
PUBLIC_SITE_URL=https://www.ejemplo.com

# Platform, publica por un solo motivo: la notificacion de pago es una ruta anonima que tiene que
# alcanzar el gateway desde afuera. PIMA y las verticales no tienen nombre publico.
PLATFORM_DOMAIN=api.ejemplo.com
ACME_EMAIL=ops@ejemplo.com

# --- base de datos ----------------------------------------------------------------------------
MARIADB_ROOT_PASSWORD=

PLATFORM_DB_NAME=platform
PLATFORM_DB_USER=platform
PLATFORM_DB_PASSWORD=

PIMA_DB_NAME=pima
PIMA_DB_USER=pima
PIMA_DB_PASSWORD=

TOURISM_DB_NAME=tourism
TOURISM_DB_USER=tourism
TOURISM_DB_PASSWORD=

# La segunda vertical. Mismo juego que la primera: una base, un usuario, una credencial de
# servicio y una etiqueta de imagen. Ni Platform ni PIMA necesitaron nada.
BIDA_DB_PASSWORD=cambiar-esto

# --- identidad --------------------------------------------------------------------------------
# La misma clave para los tres: Platform firma y PIMA y BIT validan. Minimo 32 caracteres.
JWT_SIGNING_KEY=

# Con que se sella la cookie de sesion de la consola. Minimo 32 caracteres, y **distinta** de la
# de firma: son dos secretos con dos vidas, y compartirlos hace que rotar uno rote el otro.
# Sin ella la consola se niega a arrancar. Cambiarla cierra todas las sesiones abiertas.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
JWT_ISSUER=https://api.ejemplo.com

# El primer administrador de plataforma. Se enciende UNA vez, en el primer `up` de un
# despliegue nuevo, y se vuelve a apagar — no es una cuenta de servicio, es la semilla que
# resuelve que conceder el rol de plataforma exija ya tenerlo.
#
# Minimo 12 caracteres: Platform se niega a crear un administrador con menos, porque esta cuenta
# tiene todos los permisos. Dejar `false` no rompe nada; volver a encenderlo tampoco reescribe
# la contrasena de una cuenta que ya existe, a proposito.
#   node -e "console.log(require('node:crypto').randomBytes(18).toString('base64url'))"
BOOTSTRAP_ENABLED=false
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=

# Credenciales de servicio, registradas en Platform. Hoy es un paso manual del runbook — ver
# README, "Lo que el pipeline todavia no resuelve".
PIMA_CLIENT_ID=pima-core
PIMA_CLIENT_SECRET=
TOURISM_CLIENT_ID=tourism-core
TOURISM_CLIENT_SECRET=
BIDA_CLIENT_ID=
BIDA_CLIENT_SECRET=

# --- integraciones ----------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Vacio deja a PIMA sin colectores: evalua con lo que le afirma el llamador y lo dice en su
# cobertura. Arranca y avisa; no falla.
TRUSTFULL_API_KEY=

# --- correo saliente ---------------------------------------------------------------------------
# **Sin SMTP_HOST no hay correo.** Platform arranca igual y anota en el log que *habria* mandado
# el mensaje, asi que nadie puede confirmar su direccion ni recuperar su contrasena. Es el estado
# en el que estuvo el despliegue hasta hoy.
#
# SMTP_FROM_ADDRESS es **la direccion desde la que salen los mensajes**. Es obligatoria en cuanto
# hay host: Platform se niega a arrancar sin ella.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=PIMA

# --- SMS ---------------------------------------------------------------------------------------
# Mismo trato: sin SMS_ENDPOINT el canal queda en su stand-in y los codigos por telefono no salen.
SMS_ENDPOINT=
SMS_CLIENT_ID=
SMS_CLIENT_SECRET=
